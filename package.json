{
  "name": "smartu",
  "version": "0.2.0",
  "description": "Image compression toolkit for browser, Node.js, and CLI workflows.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "smartu": "./dist/cli.mjs"
  },
  "exports": {
    "browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "import": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "require": {
      "types": "./dist/node.d.cts",
      "default": "./dist/node.cjs"
    },
    "default": "./dist/node.mjs"
  },
  "homepage": "https://github.com/yeliex/smartu",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeliex/smartu"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pkgroll --tsconfig tsconfig.base.json",
    "build:page": "pnpm build && pnpm --dir page build",
    "benchmark:strategy": "node scripts/benchmark-strategy.mjs",
    "dev:page": "pnpm --dir page dev",
    "lint": "pnpm --dir page lint",
    "prepublishOnly": "pnpm build",
    "test": "tsx --test test/**/*.test.ts",
    "test:type": "tsc -b --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.12.4",
    "@yeliex/tsconfig": "^1.0.0",
    "pkgroll": "^2.27.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "commander": "^14.0.3",
    "image-q": "^4.0.0",
    "wasm-feature-detect": "^1.8.0"
  }
}
